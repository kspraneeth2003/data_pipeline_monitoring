# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so
# never put a real secret here.

# --- Required ---------------------------------------------------------

DATABASE_URL=postgresql+psycopg://youruser@localhost:5432/dpm_dev

# Encrypts connector credentials at rest (AES-256-GCM). Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Not a secrets manager - dev-grade. Changing it makes existing stored
# credentials undecryptable, so they have to be re-entered.
CONNECTOR_SECRET_KEY=

# --- Agents -----------------------------------------------------------
#
# Both the reporting agent (monitoring/) and the maintenance agent
# (maintenance/) go through LangChain's init_chat_model, so the provider is
# this one string. Install the matching package and set its key below.
#
#   openai:gpt-5              needs `uv add langchain-openai`   + OPENAI_API_KEY
#   anthropic:claude-opus-5   needs `uv add langchain-anthropic`+ ANTHROPIC_API_KEY
#   ollama:llama3             needs `uv add langchain-ollama`   (no key)
#
# Leave AGENT_MODEL empty to run without agents. Everything still works:
# checks run, incidents open and close, issues are filed and escalated -
# the rules just do it without judgement. This is a supported way to run
# the system, not a degraded one.
AGENT_MODEL=
AGENT_TEMPERATURE=0.0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ceilings on a single agent invocation. An agent that loops is a cost
# incident; these are cheaper than finding out on a bill.
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_TIMEOUT_SECONDS=120

# --- Monitoring -------------------------------------------------------

# How often the monitor sweeps for incidents needing attention (seconds).
MONITOR_INTERVAL_SECONDS=300
# An open incident whose Jira issue has not been touched in this long gets
# escalated, and then not again for the backoff period. Measured from the
# issue's own last change, read back from Jira once per sweep.
ESCALATE_AFTER_HOURS=24
ESCALATION_BACKOFF_HOURS=24
# Most escalations one sweep may issue, oldest first. Stops a first sweep
# over an existing backlog from escalating hundreds at once.
MAX_ESCALATIONS_PER_SWEEP=10

# --- Maintenance ------------------------------------------------------

# How often to check whether any project's DDL has moved (seconds).
# Slower than the monitor: it costs a git fetch per project, and a pipeline
# definition changes on the order of days.
MAINTENANCE_INTERVAL_SECONDS=900
# Reading warehouse DDL history needs a live connection per project, so it
# is off by default. Turn it on to detect changes made directly in
# Snowflake with no commit behind them.
MAINTENANCE_SCAN_WAREHOUSE=false

# --- Jira -------------------------------------------------------------
#
# All four are required together, and Jira is the only tracker - this app
# has no ticket board of its own. With any of them missing there is no
# tracker at all: incidents are still opened, escalated and cleared in the
# app, they simply have no issue attached.
#
# JIRA_API_TOKEN is an Atlassian API token (id.atlassian.com -> Security ->
# API tokens), not your password.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# The statuses to transition to when an incident clears and when it reopens.
# Per-workflow, and renamed often enough ("Done" -> "Complete") to be worth
# configuring. Check these first if transitions are not landing.
JIRA_DONE_STATUS=Done
JIRA_REOPEN_STATUS=To Do

# --- RCA --------------------------------------------------------------

# RCA still shells out to the Claude Code CLI by default, needing no API
# key. Independent of AGENT_MODEL above.
RCA_LLM_COMMAND=claude

# --- Legacy Snowflake fallback ----------------------------------------
#
# Used only by the seeded `snowflake-default` connector. Connectors created
# through the UI carry their own credentials and ignore these.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=

# --- GitHub App (optional) --------------------------------------------
#
# Lets setup offer a repository picker instead of paste-a-URL. Everything
# degrades cleanly without it. See STATUS.md, "Connecting GitHub".
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Frontend ---------------------------------------------------------

CORS_ORIGINS=http://localhost:5173
